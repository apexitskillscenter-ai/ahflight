# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Flight Supplier Configuration
# Options: 'sandbox' | 'amadeus' | 'duffel'
FLIGHT_SUPPLIER_MODE="sandbox"

# Amadeus Self-Service Flight API (Sandbox or Production)
# Get credentials at https://developers.amadeus.com/
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
AMADEUS_ENV="test"

# Duffel Travel API (Sandbox or Production)
# Get credentials at https://duffel.com/
DUFFEL_ACCESS_TOKEN=""

# Travel Agency & Licensing Details (Pakistan Department of Tourist Services / SECP)
AGENCY_NAME="AH Flight Travel & Tours Pvt Ltd"
AGENCY_DTS_LICENSE="DTS-PK-KHI-4892"
AGENCY_DEFAULT_FEE_DOMESTIC_PKR="1500"
AGENCY_DEFAULT_FEE_INTL_PKR="4500"

# Pakistan Payment Gateway Credentials (Sandbox or Production)
PAYFAST_MERCHANT_ID=""
PAYFAST_SECURED_KEY=""
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
EASYPAISA_STORE_ID=""
